@page "EntityUi/{moduleName}/{entityName}/EditModal"
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal;
@model EasyAbp.Abp.EntityUi.Web.Pages.EntityUi.EditModalModel
@{
    Layout = null;
}

<abp-dynamic-form abp-model="ViewModel" data-ajaxForm="true" asp-page="EditModal">
    <abp-modal>
        <abp-modal-header title="@await Model.GetModalTitleAsync()"></abp-modal-header>
        <abp-modal-body>
            <input type="hidden" asp-for="Id"/>
            <abp-form-content/>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</abp-dynamic-form>
